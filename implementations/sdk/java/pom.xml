<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.spearsystems</groupId>
  <artifactId>lcp-sdk</artifactId>
  <version>0.1.0</version>
  <name>LCP Java SDK</name>
  <description>LCP Lead Context Protocol SDK</description>
  <url>https://github.com/SpearSystems/LCP</url>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <networknt.version>3.0.6</networknt.version>
    <!-- Jackson 3 (tools.jackson) is used for both the SDK's own envelope/$id
         parsing and networknt 3.x. 3.1.5 fixes CVE-2026-54512, CVE-2026-54513,
         and CVE-2026-59889 (@JsonView bypass for @JsonUnwrapped containers);
         the old Jackson 2 pins are gone with the 1.5.9 line. -->
    <jackson3.version>3.1.5</jackson3.version>
    <gpg.skip>false</gpg.skip>
  </properties>
  <licenses><license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license></licenses>
  <developers><developer><name>Spear Systems</name><organization>Spear Systems</organization></developer></developers>
  <scm><url>https://github.com/SpearSystems/LCP</url><connection>scm:git:https://github.com/SpearSystems/LCP.git</connection><developerConnection>scm:git:ssh://git@github.com/SpearSystems/LCP.git</developerConnection></scm>
  <dependencies>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId><version>${networknt.version}</version></dependency>
    <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>${jackson3.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>6.1.3</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.4.0</version><executions><execution><id>attach-sources</id><goals><goal>jar-no-fork</goal></goals></execution></executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.12.0</version><configuration><doclint>none</doclint></configuration><executions><execution><id>attach-javadocs</id><goals><goal>jar</goal></goals></execution></executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version><executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version></plugin>
      <plugin><groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.11.0</version><extensions>true</extensions><configuration><publishingServerId>central</publishingServerId><autoPublish>true</autoPublish><waitUntil>published</waitUntil></configuration></plugin>
    </plugins>
  </build>
</project>
