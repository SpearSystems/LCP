{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcp.dev/schemas/offer.json",
  "title": "LCP Buyer Offer",
  "description": "A buyer's published acceptance profile for lead routing. Offer administration is deployment-specific; this document is the interoperable discovery shape.",
  "type": "object",
  "required": [
    "offer_id",
    "buyer_id",
    "vertical",
    "countries",
    "floor_price_cents",
    "currency"
  ],
  "properties": {
    "offer_id": {
      "type": "string",
      "minLength": 1
    },
    "buyer_id": {
      "type": "string",
      "minLength": 1
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "routing_mode": {
      "type": "string",
      "enum": [
        "auction",
        "direct"
      ],
      "default": "auction",
      "description": "Direct sends a post at the floor price; auction sends a ping and waits for bids."
    },
    "vertical": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "uniqueItems": true
    },
    "state_regions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "postal_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "excluded_source_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "excluded_acquisition_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reject_incentivized": {
      "type": "boolean"
    },
    "excluded_incentive_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "require_verified_phone": {
      "type": "boolean"
    },
    "require_verified_email": {
      "type": "boolean"
    },
    "max_spam_risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "excluded_claim_language": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "require_consent_evidence": {
      "type": "boolean"
    },
    "reject_dnc_flagged": {
      "type": "boolean"
    },
    "reject_litigator_flagged": {
      "type": "boolean"
    },
    "reject_blacklist_flagged": {
      "type": "boolean"
    },
    "min_data_completeness": {
      "type": "string",
      "enum": [
        "minimal",
        "standard",
        "rich"
      ]
    },
    "floor_price_cents": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "payable_definition": {
      "type": "string"
    },
    "daily_cap": {
      "type": "integer",
      "minimum": 1
    },
    "hourly_cap": {
      "type": "integer",
      "minimum": 1
    },
    "delivery_windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/delivery_window"
      }
    },
    "ping_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "default": 30
    },
    "webhook_url": {
      "type": "string",
      "format": "uri"
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced deployment-specific criteria. Matching implementations must not execute arbitrary values as code.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "delivery_window": {
      "type": "object",
      "required": [
        "timezone",
        "available_from",
        "available_to",
        "days"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "available_from": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "available_to": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "uniqueItems": true
        },
        "verticals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
