{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcp.dev/schemas/ping.json",
  "title": "LCP Ping Message",
  "description": "Non-PII offer to buyers. STRICT ALLOWLIST — additionalProperties: false. No PII fields are permitted. The conformance runner also validates that every field in attributes is tagged ping_safe: true in the vertical schema.",
  "type": "object",
  "required": ["ping_id", "lead_reference", "phone_hash", "country_code", "vertical", "floor_price_cents", "currency"],
  "properties": {
    "ping_id": { "type": "string", "description": "Unique ping identifier." },
    "lead_reference": { "type": "string", "description": "Opaque reference to the lead (not the lead_id)." },
    "phone_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "HMAC-SHA256(shared_secret, e164) — per-pair. See SPEC.md §9." },
    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2." },
    "state_region": { "type": "string" },
    "postal_code": { "type": "string" },
    "vertical": { "type": "string", "description": "Vertical identifier." },
    "attributes": {
      "type": "object",
      "description": "Only fields tagged ping_safe: true in the vertical schema. Banded/aggregated only — never exact values.",
      "additionalProperties": true
    },
    "compliance_flags": {
      "type": "object",
      "description": "Presence indicators only — never tokens or evidence.",
      "properties": {
        "consent": { "type": "boolean" },
        "otp_verified": { "type": "boolean" },
        "dnc_checked": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "floor_price_cents": { "type": "integer", "minimum": 0 },
    "currency": { "$ref": "core.json#/$defs/currency" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}