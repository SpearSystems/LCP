{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcp.dev/schemas/core.json",
  "title": "LCP Core Definitions",
  "description": "Shared definitions for the LCP canonical core. Referenced by message-type and vertical schemas via $ref. Created by Spear Systems (a Spear company). Open standard — Apache 2.0, free to implement.",
  "type": "object",
  "$defs": {
    "consumer": {
      "type": "object",
      "title": "Consumer",
      "description": "The person the lead is about.",
      "properties": {
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "full_name": { "type": "string", "description": "Unstructured name — use when Western given/family splitting does not apply." },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "pattern": "^\\+[1-9]\\d{1,14}$", "description": "E.164 format." },
        "secondary_phone": { "type": "string", "pattern": "^\\+[1-9]\\d{1,14}$", "description": "Secondary phone (work, spouse, alternate). E.164. Optional." },
        "preferred_contact_method": { "type": "string", "enum": ["phone", "email", "sms", "any"], "description": "Consumer's preferred contact method. Affects contact strategy and compliance." },
        "phone_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "HMAC-SHA256(shared_secret, e164). 64 hex chars." },
        "dob": { "type": "string", "format": "date", "description": "Sensitive." },
        "email_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "HMAC-SHA256(shared_secret, normalized_email). For dedup in ping. Same per-pair model as phone_hash." },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-zA-Z]{1,7})?$", "description": "BCP-47 language tag (e.g. en-AU, es-US)." }
      },
      "anyOf": [
        { "required": ["email"] },
        { "required": ["phone"] },
        { "required": ["first_name", "last_name"] },
        { "required": ["full_name"] }
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "title": "Location",
      "properties": {
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2. Required." },
        "state_region": { "type": "string", "description": "Per-country validation registry (state, province, region)." },
        "postal_code": { "type": "string", "description": "Per-country format." },
        "city": { "type": "string" },
        "timezone": { "type": "string", "description": "IANA timezone (e.g. Australia/Sydney)." }
      },
      "required": ["country_code"],
      "anyOf": [
        { "required": ["state_region"] },
        { "required": ["postal_code"] }
      ],
      "additionalProperties": false
    },
    "consent_evidence_entry": {
      "type": "object",
      "title": "Consent Evidence Entry",
      "description": "A single piece of consent or compliance evidence.",
      "properties": {
        "type": { "type": "string", "description": "Consent framework or evidence type (e.g. tcpa_consent, gdpr_opt_in)." },
        "provider": { "type": "string", "description": "Vendor or system (e.g. jornaya, trustedform, internal)." },
        "token_or_url": { "type": "string", "description": "Verification token, certificate URL, or reference." }
      },
      "required": ["type", "provider", "token_or_url"],
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "title": "Compliance",
      "description": "Consent and regulatory compliance evidence.",
      "properties": {
        "consent_timestamp": { "type": "string", "format": "date-time" },
        "consent_source_url": { "type": "string", "format": "uri" },
        "consent_text_version": { "type": "string" },
        "consent_purposes": { "type": "array", "items": { "type": "string" }, "description": "What was consented to (e.g. calls, sms, email, share_with_partners)." },
        "consent_evidence": { "type": "array", "items": { "$ref": "core.json#/$defs/consent_evidence_entry" } },
        "otp_verified": { "type": "boolean", "description": "One-time-passcode verified." },
        "otp": {
          "type": "object",
          "description": "OTP verification details. The actual OTP code MUST NOT be included.",
          "properties": {
            "channel": { "type": "string", "enum": ["sms", "email", "voice"] },
            "verified_at": { "type": "string", "format": "date-time" },
            "verified_value_hash": { "type": "string" },
            "attempts": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "session_capture_id": { "type": "string" },
        "call_recording_id": { "type": "string" },
        "dnc_checked": { "type": "boolean" },
        "consent_expires_at": { "type": "string", "format": "date-time" },
        "scrubs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "provider": { "type": "string" },
              "result": { "type": "string", "enum": ["clean", "flagged", "blocked", "not_checked"] },
              "checked_at": { "type": "string", "format": "date-time" },
              "details": { "type": "string" }
            },
            "required": ["type", "result"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "title": "Provenance",
      "description": "Non-PII origin metadata.",
      "properties": {
        "received_at": { "type": "string", "format": "date-time" },
        "source_type": { "type": "string", "description": "Open enumeration of source types." },
        "acquisition_method": { "type": "string", "description": "Open enumeration of acquisition methods." },
        "is_incentivized": { "type": "boolean" },
        "incentive_type": { "type": "string" },
        "source_id": { "type": "string" },
        "source_url": { "type": "string", "format": "uri" },
        "ip_hash": { "type": "string" },
        "user_agent_hash": { "type": "string" },
        "funnel_key": { "type": "string" },
        "flow_key": { "type": "string" },
        "campaign_id": { "type": "string" },
        "creative_id": { "type": "string" },
        "landing_page_url": { "type": "string", "format": "uri" },
        "platform_source": { "type": "string" },
        "brand_id": { "type": "string", "description": "Publisher-owned brand identifier." },
        "form_id": { "type": "string", "description": "Stable form or flow identifier." },
        "agent": {
          "type": "object",
          "properties": {
            "agent_id": { "type": "string" },
            "acting_for": { "type": "string" },
            "attestation": { "type": "string" }
          },
          "required": ["agent_id", "acting_for", "attestation"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "title": "Attributes",
      "description": "Vertical-specific fields. Shape defined by per-vertical JSON Schema in verticals/.",
      "properties": {
        "vertical": { "type": "string" },
        "schema_version": { "type": "string" }
      },
      "required": ["vertical", "schema_version"]
    },
    "attachments": {
      "type": "array",
      "description": "Metadata for encrypted, out-of-band files. Binary content is never embedded in an LCP JSON envelope.",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["attachment_id", "purpose", "filename", "content_type", "size_bytes", "sha256", "storage_ref", "created_at"],
        "properties": {
          "attachment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 100 },
          "filename": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" },
          "content_type": { "type": "string", "pattern": "^[^;\\s]+/[^;\\s]+$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "storage_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "encryption": { "type": "string", "enum": ["application_encrypted", "provider_encrypted"] },
          "residency": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,31}$", "description": "Country or deployment region where the attachment bytes are stored and scanned." },
          "malware_scan": {
            "type": "object",
            "description": "Non-sensitive malware scan evidence. A production attachment must have status clean before release.",
            "properties": {
              "status": { "type": "string", "enum": ["clean", "not_scanned"] },
              "engine": { "type": "string", "minLength": 1, "maxLength": 100 },
              "scanned_at": { "type": "string", "format": "date-time" }
            },
            "required": ["status", "engine", "scanned_at"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "title": "Lead Status",
      "description": "Open enumeration of lifecycle statuses."
    },
    "channel": {
      "type": "string",
      "title": "Lead Channel",
      "description": "Open enumeration of lead channels."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^LCP-\\d{3}$" },
        "name": { "type": "string" },
        "message": { "type": "string" },
        "field": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "errors_array": {
      "type": "object",
      "properties": {
        "errors": { "type": "array", "items": { "$ref": "core.json#/$defs/error" }, "minItems": 1 }
      },
      "required": ["errors"],
      "additionalProperties": false
    },
    "exclusivity": {
      "type": "object",
      "properties": {
        "exclusivity": { "type": "string", "enum": ["exclusive", "shared"], "default": "shared" },
        "max_buyers": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "expiry": {
      "type": "object",
      "properties": {
        "expires_at": { "type": "string", "format": "date-time" },
        "ttl_seconds": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [{ "required": ["expires_at"] }, { "required": ["ttl_seconds"] }],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "signature": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "algorithm": { "type": "string", "const": "HMAC-SHA256" }
      },
      "required": ["signature", "timestamp", "algorithm"],
      "additionalProperties": false
    }
  }
}
