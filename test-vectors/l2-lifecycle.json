    {
      "id": "L2-001",
      "name": "valid_lead_payload",
      "expect": "pass",
      "file": "lead.json",
      "checks": [
        "lead_schema",
        "consumer_required_fields",
        "location_required",
        "attributes_vertical_version"
      ]
    },
    {
      "id": "L2-002",
      "name": "valid_call_payload",
      "expect": "pass",
      "file": "call.json",
      "checks": [
        "call_schema",
        "call_block_required",
        "consumer_required_fields"
      ]
    },
    {
      "id": "L2-003",
