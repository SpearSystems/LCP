{
  "suite": "lcp-sdk-negative",
  "version": 1,
  "group": "slot-fields",
  "description": "LEP-0003 (v1.1) slot/dedup wire surface: exclusive is exactly one slot, the slot minimum/maximum bounds, and the contacted-hash shape/bound. Every digest entry must be lowercase 64-hex per-pair HMAC-SHA256 (SPEC.md \u00a79); the record's invalid shapes A/B and the RF-1/F4 classes are refused by the published schemas.",
  "vectors": [
    {
      "id": "lcp-neg-exclusive-multislot-001",
      "invariant": null,
      "spec_ref": "SPEC.md \u00a73/\u00a74/\u00a79 (slot semantics, capability gate, contact hashes); schemas/ping.json|bid.json|post.json; LEP-0003 \u00a71-\u00a73; #153 T7",
      "description": "LEP-0003 invalid example B (#153 T7/F8): an exclusive lead advertising slots_available 3 contradicts the one-slot special case. Rejected by the ping.json top-level conditional (exclusivity 'exclusive' implies slots_available const 1) \u2014 under the naive min-only draft this shape validated, which is exactly the defect the dossier recorded.",
      "applies_to": [
        "ping"
      ],
      "check": "envelope_validate",
      "inputs": {
        "envelope": {
          "lcp": {
            "version": "1.1.0",
            "message": {
              "id": "fa0e8400-0000-4000-8000-000000000201",
              "type": "ping",
              "timestamp": "2026-11-02T10:20:05Z",
              "sender_id": "platform_001",
              "receiver_id": "buyer_002",
              "correlation_id": null,
              "idempotency_key": "platform-001-ping-ping_002-001",
              "test": true
            },
            "payload": {
              "ping_id": "ping_002",
              "lead_reference": "ref_qwe456",
              "phone_hash": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
              "country_code": "US",
              "state_region": "TX",
              "postal_code": "78701",
              "vertical": "home_services",
              "attributes": {
                "service_type": "gutters",
                "budget_band": "1000_5000"
              },
              "floor_price_cents": 2400,
              "currency": "USD",
              "exclusivity": "exclusive",
              "slots_available": 3,
              "dedup_window_hours": 24,
              "expires_at": "2026-11-02T10:25:05Z"
            }
          }
        }
      },
      "sdk_exercisable": true,
      "expect": {
        "outcome": "reject",
        "error_code": "LCP-100",
        "error_name": "VALIDATION_ERROR"
      }
    },
