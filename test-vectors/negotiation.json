{
  "suite": "NEG",
  "description": "LEP-0009 agent-to-agent negotiation: bounded quote/counter rounds, monotone prices, floor refusal without clamping, absolute expiry, capability gating, single-use binding tokens, and tenancy (ids NEG-001..NEG-010).",
  "vectors": [
    {
      "id": "NEG-001",
      "name": "valid_opening_quote",
      "expect": "pass",
      "description": "LEP-0009 \u00a72: the platform opens a negotiation for a pinged buyer. Ask above the restated floor, expires_at equal to the ping's expiry, max_rounds inside the cap, no field outside the strict allowlist.",
      "receiver_lcp_versions": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ],
      "receiver_features": {
        "batch": "1.2.0",
        "negotiation": "1.2.0"
      },
      "ping_expires_at": "2026-11-04T12:10:00Z",
      "checks": [
        "envelope_schema",
        "quote_schema",
        "required_fields",
        "idempotency_key",
        "iso_timestamp",
        "negotiation_capability",
        "negotiation_no_pii",
        "negotiation_floor_refused",
        "negotiation_round_cap",
        "negotiation_expiry"
      ],
      "payload": {
        "lcp": {
          "version": "1.2.0",
          "message": {
            "id": "a10e8400-0000-4000-8000-000000000901",
            "type": "quote",
            "timestamp": "2026-11-04T12:00:00Z",
            "sender_id": "platform_001",
            "receiver_id": "buyer_001",
            "correlation_id": "d70e8400-0000-4000-8000-000000000021",
            "idempotency_key": "platform-001-quote-neg_7c1f0a9b2e4d-1",
            "test": false
          },
          "payload": {
            "negotiation_id": "neg_7c1f0a9b2e4d",
            "ping_id": "ping_9f31c2",
            "offer_id": "offer_mortgage_nsw",
            "price_cents": 10000,
            "currency": "AUD",
            "floor_price_cents": 6000,
            "max_rounds": 3,
            "rounds_remaining": 3,
            "expires_at": "2026-11-04T12:10:00Z"
          }
        }
      }
    },
    {
      "id": "NEG-002",
