    {
      "id": "L3-002",
      "name": "valid_status_transitions",
      "expect": "pass",
      "description": "Valid status transition sequence: NEW → PINGED → POSTED → ACCEPTED → CONVERTED.",
      "transitions": [
        {"from": "NEW", "to": "PINGED", "valid": true},
        {"from": "PINGED", "to": "POSTED", "valid": true},
        {"from": "POSTED", "to": "ACCEPTED", "valid": true},
        {"from": "ACCEPTED", "to": "CONVERTED", "valid": true},
        {"from": "POSTED", "to": "REJECTED", "valid": true},
        {"from": "POSTED", "to": "EXPIRED", "valid": true},
        {"from": "POSTED", "to": "DUPLICATE", "valid": true},
        {"from": "ACCEPTED", "to": "DISPUTED", "valid": true},
        {"from": "DISPUTED", "to": "REFUNDED", "valid": true},
        {"from": "DISPUTED", "to": "ACCEPTED", "valid": true},
        {"from": "ACCEPTED", "to": "ARCHIVED", "valid": true},
        {"from": "NEW", "to": "REJECTED", "valid": true},
        {"from": "NEW", "to": "EXPIRED", "valid": true},
        {"from": "NEW", "to": "DUPLICATE", "valid": true},
        {"from": "PINGED", "to": "EXPIRED", "valid": true},
        {"from": "PINGED", "to": "DUPLICATE", "valid": true},
        {"from": "CONVERTED", "to": "ACCEPTED", "valid": false, "error": "LCP-004"},
        {"from": "CONVERTED", "to": "DISPUTED", "valid": false, "error": "LCP-004"},
        {"from": "REJECTED", "to": "ACCEPTED", "valid": false, "error": "LCP-004"},
        {"from": "EXPIRED", "to": "ACCEPTED", "valid": false, "error": "LCP-004"},
        {"from": "REFUNDED", "to": "ACCEPTED", "valid": false, "error": "LCP-004"},
        {"from": "ARCHIVED", "to": "ACCEPTED", "valid": false, "error": "LCP-004"},
        {"from": "DUPLICATE", "to": "POSTED", "valid": false, "error": "LCP-004"},
        {"from": "NEW", "to": "ACCEPTED", "valid": false, "error": "LCP-004"},
        {"from": "NEW", "to": "CONVERTED", "valid": false, "error": "LCP-004"}
      ],
      "checks": ["status_transition_graph"]
    },
