{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcp.dev/verticals/home_services.json",
  "title": "LCP Home Services Vertical Schema",
  "description": "Home services lead attributes. Every field is tagged ping_safe: true|false — the conformance runner rejects any ping containing a non-ping_safe field. Created by Spear Systems (a Spear company). Open standard — Apache 2.0, free to implement.",
  "type": "object",
  "required": ["vertical", "schema_version"],
  "properties": {
    "vertical": { "type": "string", "const": "home_services" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "service_type": {
      "type": "string",
      "enum": ["roofing", "plumbing", "hvac", "electrical", "landscaping", "painting", "general_repair"],
      "ping_safe": true
    },
    "project_type": {
      "type": "string",
      "enum": ["repair", "install", "maintenance"],
      "description": "Type of project requested.",
      "ping_safe": true
    },
    "urgency": {
      "type": "string",
      "enum": ["emergency", "within_week", "within_month", "flexible"],
      "description": "How urgently service is needed.",
      "ping_safe": true
    },
    "property_type": {
      "type": "string",
      "enum": ["single_family", "condo", "townhouse", "multi_family", "commercial", "other"],
      "ping_safe": true
    },
    "property_age_band": {
      "type": "string",
      "enum": ["under_5", "5_15", "15_30", "30_50", "over_50", "unknown"],
      "description": "Banded property age in years.",
      "ping_safe": true
    },
    "budget_band": {
      "type": "string",
      "enum": ["under_500", "500_1000", "1000_5000", "5000_10000", "10000_25000", "over_25000"],
      "description": "Banded budget for the project.",
      "ping_safe": true
    },
    "preferred_schedule": {
      "type": "string",
      "enum": ["asap", "within_week", "within_month", "flexible", "specific_date"],
      "description": "Preferred scheduling timeframe.",
      "ping_safe": true
    },
    "has_existing_damage": {
      "type": "boolean",
      "description": "Is there existing damage requiring repair?",
      "ping_safe": true
    },
    "damage_type": {
      "type": "string",
      "enum": ["water", "fire", "storm", "mold", "structural", "pest", "wear_tear", "other", "none"],
      "description": "Type of damage if present.",
      "ping_safe": true
    },
    "square_footage_band": {
      "type": "string",
      "enum": ["under_1000", "1000_1500", "1500_2000", "2000_3000", "3000_5000", "over_5000"],
      "description": "Banded property square footage.",
      "ping_safe": true
    },
    "number_of_rooms_band": {
      "type": "string",
      "enum": ["under_3", "3_5", "5_7", "7_10", "over_10"],
      "description": "Banded number of rooms.",
      "ping_safe": true
    }
  },
  "additionalProperties": false
}